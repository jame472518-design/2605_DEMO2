// secrets.h — DO NOT COMMIT. Copy this file to `secrets.h` and fill in your values.
//
// Why split? Hard-coding WiFi credentials + tokens in the .ino itself would
// leak them on every git push. `secrets.h` is gitignored; this `.example`
// version is the public template.

#pragma once

// ----- WiFi (2.4GHz only — ESP32-S3 doesn't speak 5GHz) -----------------------
#define WIFI_SSID      "your_wifi_ssid"
#define WIFI_PASSWORD  "your_wifi_password"

// ----- demo2 plugin host (the PC running the OpenClaw gateway) ----------------
// Find with `ipconfig` (Windows) on your demo PC. Use the LAN IP, not 127.0.0.1
// — the ESP32 needs to reach it over WiFi.
#define PC_HOST        "192.168.1.100"

// ----- Gateway auth token -----------------------------------------------------
// Copy the value from demo2/.env.local (the line starting with
// OPENCLAW_GATEWAY_TOKEN=). Long hex string written by bootstrap-profile.ps1.
#define GATEWAY_TOKEN  "PASTE_OPENCLAW_GATEWAY_TOKEN_HERE"

// ----- Optional: device identity ---------------------------------------------
// Helpful when you eventually run more than one ESP32. The dashboard's
// CameraCard displays this in the header.
#define DEVICE_ID      "esp32-sensor-1"
