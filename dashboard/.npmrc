# pnpm 11+ moved settings out of package.json's `pnpm` field. Keeping the
# esbuild postinstall whitelist here ensures the vite/esbuild bin downloads
# its platform binary even if pnpm tightens the default again later. Using
# .npmrc (not pnpm-workspace.yaml) so pnpm doesn't treat dashboard/ as a
# workspace root.
only-built-dependencies[]=esbuild
